<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DarkMoon.Views.MainWindow"
        Title="Dark moon"
        Width="320" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

  <Border Margin="16" CornerRadius="16"
          Background="#16213e"
          BorderBrush="#2a2a4a" BorderThickness="1">
    <StackPanel Margin="20">

      <!-- Header -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Dark moon"
                     FontSize="20" FontWeight="SemiBold"
                     Foreground="White"/>
          <TextBlock Text="by Omnori"
                     FontSize="11"
                     Foreground="#888"/>
        </StackPanel>

        <!-- Connection indicator: green once a DDC/CI monitor answers, grey otherwise -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Top" Margin="0,3,0,0"
                    ToolTip.Tip="Whether a DDC/CI-capable monitor was found">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#666"/>
        </StackPanel>
      </Grid>

      <!-- Sliders Card -->
      <Border CornerRadius="12"
              BorderBrush="#2a2a4a" BorderThickness="1"
              Background="#0f0f23"
              Padding="16" Margin="0,0,0,16">
        <StackPanel Spacing="16">

          <!-- Brightness -->
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Brightness :" Foreground="#ccc" FontSize="13"/>
              <TextBlock Grid.Column="1"
                         x:Name="BrightnessValue"
                         Text="25 %" Foreground="#ccc" FontSize="13"/>
            </Grid>
            <Slider x:Name="BrightnessSlider"
                    Minimum="0" Maximum="100" Value="25"
                    ValueChanged="BrightnessSlider_ValueChanged"/>
          </StackPanel>

          <!-- Contrast -->
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Contrast :" Foreground="#ccc" FontSize="13"/>
              <TextBlock Grid.Column="1"
                         x:Name="ContrastValue"
                         Text="25 %" Foreground="#ccc" FontSize="13"/>
            </Grid>
            <Slider x:Name="ContrastSlider"
                    Minimum="0" Maximum="100" Value="25"
                    ValueChanged="ContrastSlider_ValueChanged"/>
          </StackPanel>

          <!-- Temperature -->
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Temperature :" Foreground="#ccc" FontSize="13"/>
              <TextBlock Grid.Column="1"
                         x:Name="TemperatureValue"
                         Text="25 %" Foreground="#ccc" FontSize="13"/>
            </Grid>
            <Slider x:Name="TemperatureSlider"
                    Minimum="0" Maximum="100" Value="25"
                    ValueChanged="TemperatureSlider_ValueChanged"/>
          </StackPanel>

          <!-- Blue Light Filter: honestly disabled rather than a slider that silently does
               nothing. DDC/CI and dxva2 have no "blue light" primitive; doing this properly
               needs per-platform gamma-ramp control, which is a separate feature. -->
          <StackPanel Opacity="0.5"
                      ToolTip.Tip="Blue light filtering needs software gamma control, which isn't wired up yet — coming soon">
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Blue Light Filter (coming soon):" Foreground="#ccc" FontSize="13"/>
              <TextBlock Grid.Column="1"
                         x:Name="BlueLightValue"
                         Text="-- %" Foreground="#ccc" FontSize="13"/>
            </Grid>
            <Slider x:Name="BlueLightSlider"
                    Minimum="0" Maximum="100" Value="0"
                    IsEnabled="False"/>
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- Status line: every apply/refresh reports what actually happened instead of
           silently doing nothing (the old Console.WriteLine calls were invisible to users) -->
      <TextBlock x:Name="StatusText"
                 Text="Reading monitor…"
                 FontSize="12" Foreground="#888"
                 TextWrapping="Wrap"
                 Margin="2,0,2,12"/>

      <!-- Footer: sliders already apply live (debounced) as you drag them, like a native OS
           brightness control, so there's nothing left to "Apply" or "Cancel" -->
      <Grid ColumnDefinitions="*,10,*,10,*">
        <Button Grid.Column="0" Content="Refresh"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="Refresh_Click"/>
        <Button Grid.Column="2" Content="About"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="About_Click"/>
        <Button Grid.Column="4" Content="Close"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="Close_Click"/>
      </Grid>

    </StackPanel>
  </Border>
</Window>
